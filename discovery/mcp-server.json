{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.max124vip-dev/tools-for-agents",
  "title": "Tools for Agents",
  "description": "Decision Layer for AI Agents — 44 MCP tools, 58+ REST tools. 5,000 FREE req/day. Key: POST /v1/register {}.",
  "version": "0.1.0",
  "websiteUrl": "https://toolsforagents.tools",
  "documentationUrl": "https://api.toolsforagents.tools/docs",
  "repository": {
    "url": "https://github.com/max124vip-dev/tools-for-agents",
    "source": "github"
  },
  "icons": [
    {
      "src": "https://toolsforagents.tools/assets/logo.svg",
      "mimeType": "image/svg+xml"
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://api.toolsforagents.tools/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Bearer API key from POST https://api.toolsforagents.tools/v1/register with body {} (no email). Example: Bearer sk_live_...",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ],
  "discovery": {
    "well_known": "https://api.toolsforagents.tools/.well-known/mcp.json",
    "oauth_protected_resource": "https://api.toolsforagents.tools/.well-known/oauth-protected-resource",
    "oauth_authorization_server": "https://api.toolsforagents.tools/.well-known/oauth-authorization-server",
    "onboarding": "https://api.toolsforagents.tools/v1/onboarding",
    "register": "https://api.toolsforagents.tools/v1/register",
    "register_agent": "https://api.toolsforagents.tools/v1/register/agent",
    "siwe_nonce": "https://api.toolsforagents.tools/v1/auth/siwe/nonce",
    "siwe_verify": "https://api.toolsforagents.tools/v1/auth/siwe/verify",
    "trust_handshake": "https://api.toolsforagents.tools/v1/trust/verify-handshake",
    "ucp_hints": "https://api.toolsforagents.tools/.well-known/ucp.json",
    "ap2_hints": "https://api.toolsforagents.tools/.well-known/ap2.json",
    "discover": "https://api.toolsforagents.tools/v1/discover",
    "advisor": "https://api.toolsforagents.tools/v1/advisor",
    "commons_recall": "https://api.toolsforagents.tools/v1/commons/recall",
    "llms_txt": "https://toolsforagents.tools/llms.txt",
    "github": "https://github.com/max124vip-dev/tools-for-agents"
  }
}
